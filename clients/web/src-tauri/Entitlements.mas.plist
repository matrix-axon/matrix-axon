<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Entitlements for the Mac App Store build, used only by
    scripts/package-macos-mas.sh. Entitlements.plist is the Developer ID set
    and stays as it is; the two are different mechanisms (hardened runtime vs
    App Sandbox) and neither is a superset of the other.

    TEAMID is substituted by the script from the signing identity. The
    application-identifier must equal the one in the embedded provisioning
    profile or the upload is rejected.

    - app-sandbox is mandatory for the store.
    - network.client: the app talks to the user's Axon server.
    - device.camera: QR sign-in (see Entitlements.plist).
    - files.user-selected.read-write: attaching media and saving downloads
      through the open/save panels.
  -->
  <key>com.apple.application-identifier</key>
  <string>TEAMID.org.matrixaxon.axon</string>
  <key>com.apple.developer.team-identifier</key>
  <string>TEAMID</string>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
