{
  "name": "axon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0+sha256.33dd0748f27e7916c4f1c8b6943461983e3453b06bbda6312a6280130b4881e5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../../openapi/openapi.json -o src/api/schema.d.ts",
    "check:api": "node scripts/check-api-schema.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:e2e:perf": "pnpm build && PERF=1 playwright test timeline-back-perf",
    "demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.9.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "brace-expansion": "2.1.4",
    "browserslist": "4.28.9",
    "dompurify": "^3.4.13",
    "emoji-picker-element": "1.29.1",
    "emoji-picker-element-data": "1.8.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "4.3.2",
    "jsqr": "^1.4.0",
    "marked": "^18.0.5",
    "nanoid": "3.3.18",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.2.108",
    "postcss": "8.5.25",
    "preact": "^10.29.3",
    "preact-iso": "^2.12.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
