# Copy to .env and adjust. .env is gitignored.
#
# These configure the local docker-compose Postgres and the connection
# string the app uses to reach it. The defaults are fine for local dev;
# change the password for any non-local deployment.

POSTGRES_USER=axon
POSTGRES_PASSWORD=axon
POSTGRES_DB=axon

# Host port the docker-compose Postgres binds to. Change this if 5432 is
# already taken by a local Postgres (e.g. Homebrew/Postgres.app on macOS),
# and update the port in DATABASE_URL to match.
POSTGRES_PORT=5432

# Host where run.sh/run.ps1 looks for an existing local Postgres instance.
# If a Postgres server is reachable here at POSTGRES_PORT when the script
# starts, Docker Compose is skipped entirely and that instance is used instead.
# Defaults to 127.0.0.1 when unset.
# POSTGRES_HOST=127.0.0.1

# Connection string for axon-server. Loaded automatically from .env at startup.
DATABASE_URL=postgres://axon:axon@127.0.0.1:5432/axon

# --- CLI-only vars -----------------------------------------------------------
# These aren't config fields — they're read directly by the CLI/HTTP-client
# commands (axon utd redecrypt, etc.), not by the server's config loader.

# Path to axon.toml, if not passed via --config. Falls back to ./axon.toml,
# then the platform config directory.
# AXON_CONFIG=/etc/axon/axon.toml

# Base URL of a running axon-server for CLI subcommands that call it over
# HTTP (e.g. `axon utd redecrypt`). Defaults to http://127.0.0.1:8080 — set
# this explicitly whenever the server isn't local, or the CLI call fails
# with a 401 that looks like a bad token but is really the wrong host.
# AXON_BASE_URL=https://axon.example.com

# Bearer token for CLI subcommands that call the server over HTTP, in place
# of passing --token on the command line.
# AXON_TOKEN=axon_...

# --- Sync engine (optional) ------------------------------------------------
# The server boots without these; omit them to run with no sync / no accounts.

# Symmetric key for encrypting account access tokens at rest and passphrasing
# the matrix-rust-sdk store. Required once any account exists. Maps onto
# sync.store_key. Choose a strong random value; keep it stable — changing it
# invalidates existing encrypted tokens and SDK stores.
AXON_SYNC__STORE_KEY=change-me

# Matrix OAuth discovery/dynamic-registration request timeout. Default 15.
# AXON_SYNC__MATRIX_OAUTH__REQUEST_TIMEOUT_SECS=15
# Static public client registrations are normally clearer in axon.toml. They
# can also be expressed as labeled environment fields when config must be
# environment-only:
# AXON_SYNC__MATRIX_OAUTH__STATIC_REGISTRATIONS__MAS__SERVER_URL=https://auth.example.org/
# AXON_SYNC__MATRIX_OAUTH__STATIC_REGISTRATIONS__MAS__CLIENT_ID=01JAXONPUBLICCLIENT

# Accounts are added at runtime, not via env/config: POST /v1/accounts/login
# (password) or POST /v1/accounts/import (an existing access_token +
# device_id) — see the API docs.

# Directory for the matrix-rust-sdk state + crypto stores. Must be durable.
# Defaults to the platform data directory's axon/sync.
# AXON_SYNC__DATA_DIR=axon-data/sync
# Per-room timeline window the sliding-sync list requests. Default 20.
# AXON_SYNC__TIMELINE_LIMIT=20
# Capacity of the live-event bus feeding /v1/ws. Default 1024.
# AXON_SYNC__LIVE_EVENT_BUFFER=1024
# Per-call timeout for an outbound message-like mutation (send/edit/redact/
# react), in seconds — defense-in-depth against a slow SyncService (ADR 0030,
# issue #241). Default 30.
# AXON_SYNC__SEND_MUTATION_TIMEOUT_SECS=30
# Per-call timeout for an outbound ephemeral send (read receipt / typing), in
# seconds. Default 10.
# AXON_SYNC__EPHEMERAL_SEND_TIMEOUT_SECS=10
# Per-call timeout for an outbound room-membership mutation (leave/forget/
# invite/kick/ban/unban) or room-settings mutation (name/topic/remove_avatar/
# tags), in seconds. Both share this one timeout: local-room state/account-
# data writes, no federation resolution involved. Avatar-set reuses
# AXON_MEDIA__UPSTREAM_UPLOAD_TIMEOUT_SECS instead, since it does a real
# media upload. Default 15.
# AXON_SYNC__MEMBERSHIP_MUTATION_TIMEOUT_SECS=15
# Per-call timeout for an outbound room-entry mutation (join/knock/
# create_room/create_dm), in seconds. Longer than the membership timeout
# since these can involve federation resolution. Default 30.
# AXON_SYNC__ROOM_ENTRY_TIMEOUT_SECS=30
# Enable the M10 history-backfill engine. Default true.
# AXON_SYNC__BACKFILL_ENABLED=true
# Retry every pending UTD on every process start instead of once. Default false.
# AXON_SYNC__ALWAYS_REDECRYPT_UTDS_ON_STARTUP=false
# Events requested per /messages page during backfill. Default 100.
# AXON_SYNC__BACKFILL_PAGE_SIZE=100
# Per-room bound on events backfill pulls before stopping; 0 = unbounded.
# Default 0.
# AXON_SYNC__BACKFILL_TARGET_DEPTH=0
# Delay between backfill pages, in milliseconds. Default 1000.
# AXON_SYNC__BACKFILL_THROTTLE_MS=1000
# Per-request timeout for a backfill /messages page, in seconds. Default 30.
# AXON_SYNC__BACKFILL_PAGE_TIMEOUT_SECS=30
# How long backfill idles before re-polling the room list once caught up, in
# seconds. Default 45.
# AXON_SYNC__BACKFILL_IDLE_POLL_SECS=45
# Filesystem the backfill disk-space valve watches. Defaults to sync.data_dir.
# AXON_SYNC__BACKFILL_DISK_GUARD_PATH=/var/lib/postgresql
# Backfill pauses below this many free bytes on the guarded filesystem.
# Default 2147483648 (2 GiB).
# AXON_SYNC__BACKFILL_MIN_FREE_BYTES=2147483648
# Backfill also pauses below this free-space percentage. Default 5.0.
# AXON_SYNC__BACKFILL_MIN_FREE_PERCENT=5.0
# Destructively purge a room's stored events/state/search docs on leave
# instead of just hiding them. Default false.
# AXON_SYNC__PURGE_ON_LEAVE=false

# --- Server ------------------------------------------------------------------

# Bind address. Defaults to loopback; put a reverse proxy in front for
# external access.
# AXON_SERVER__HOST=127.0.0.1
# Port to bind. Default 8080.
# AXON_SERVER__PORT=8080
# Permit binding a non-loopback address while serving plain HTTP. Default false.
# AXON_SERVER__ALLOW_INSECURE_BIND=false
# Permit the one-time first-credential web bootstrap from non-loopback peers.
# Default false.
# AXON_SERVER__BOOTSTRAP_WEB_ALLOW_REMOTE=false
# Optional web-client URL the bootstrap success page links to.
# AXON_SERVER__WEB_CLIENT_URL=https://axon.example.com/app

# --- Database ------------------------------------------------------------------

# Alternative to the bare DATABASE_URL above.
# AXON_DATABASE__URL=postgres://axon:axon@127.0.0.1:5432/axon
# Maximum size of the connection pool. Default 5.
# AXON_DATABASE__MAX_CONNECTIONS=5

# --- Logging -------------------------------------------------------------------

# tracing filter directive. Overridden by RUST_LOG when set. Built-in default:
# "info,matrix_sdk_crypto=error,matrix_sdk::encryption::backups=error"
# AXON_LOG__LEVEL=info

# --- Full-text search (Tantivy) -------------------------------------------------

# Whether the search index is built and served. Default true.
# AXON_SEARCH__ENABLED=true
# Directory holding the Tantivy index. Must be durable. Defaults to the
# platform data directory's axon/search.
# AXON_SEARCH__INDEX_PATH=axon-data/search
# Rows streamed per batch by the indexer. Default 1000.
# AXON_SEARCH__INDEX_BATCH_SIZE=1000
# Delay between corpus-seed batches, in milliseconds. Default 0.
# AXON_SEARCH__BUILD_THROTTLE_MS=0
# Heap budget for the Tantivy IndexWriter, in megabytes. Default 50.
# AXON_SEARCH__WRITER_HEAP_MB=50
# Maximum concurrent GET /v1/search queries. Default 8.
# AXON_SEARCH__MAX_CONCURRENT_QUERIES=8
# Per-query wall-clock budget for GET /v1/search, in milliseconds. Default 10000.
# AXON_SEARCH__QUERY_TIMEOUT_MS=10000

# --- Media proxy / cache ---------------------------------------------------------

# Whether the on-disk media cache is used. Default true.
# AXON_MEDIA__ENABLED=true
# Directory holding the media cache. Defaults to the platform cache
# directory's axon/media.
# AXON_MEDIA__CACHE_DIR=axon-data/media
# Durable staging directory for client-originated media uploads. Defaults to
# the platform data directory's axon/uploads.
# AXON_MEDIA__UPLOADS_DIR=axon-data/uploads
# Total cache size cap, in bytes. Default 5368709120 (5 GiB).
# AXON_MEDIA__MAX_BYTES=5368709120
# Per-object size cap, in bytes; larger objects are never cached. Default
# 104857600 (100 MiB).
# AXON_MEDIA__MAX_OBJECT_BYTES=104857600
# Per-request timeout for the upstream homeserver media download, in
# seconds. Default 60.
# AXON_MEDIA__FETCH_TIMEOUT_SECS=60
# Maximum upstream media downloads in flight at once. Default 16.
# AXON_MEDIA__MAX_CONCURRENT_DOWNLOADS=16
# Maximum accepted client upload body, in bytes. Default 104857600 (100 MiB).
# AXON_MEDIA__MAX_UPLOAD_BYTES=104857600
# Wall-clock budget for accepting one upload request, in seconds. Default 60.
# AXON_MEDIA__UPLOAD_REQUEST_TIMEOUT_SECS=60
# Wall-clock budget for the later homeserver upload/send step, in seconds.
# Default 60.
# AXON_MEDIA__UPSTREAM_UPLOAD_TIMEOUT_SECS=60
# Maximum client uploads streamed to disk concurrently. Default 4.
# AXON_MEDIA__MAX_CONCURRENT_UPLOADS=4
# How long an unsent staged upload remains reusable before boot reconcile
# prunes it, in seconds. Default 86400 (24h).
# AXON_MEDIA__STAGED_UPLOAD_TTL_SECS=86400

# --- OAuth 2.0 (M14, ADR 0054) ---------------------------------------------------
# Disabled by default; existing CLI-token deployments are unaffected.
# Statically pre-registered clients ([[oauth.clients]]) are array config and
# can only be set in axon.toml, not via flat env vars.

# Whether the /v1/oauth/* surface is served at all. Default false.
# AXON_OAUTH__ENABLED=false
# This instance's externally-reachable base URL. Required once enabled=true.
# AXON_OAUTH__EXTERNAL_BASE_URL=https://myaxon.example.com
# How long a minted access token verifies for, in seconds. Default 3600 (1h).
# AXON_OAUTH__ACCESS_TOKEN_TTL_SECS=3600
# How long a minted refresh token is redeemable for, in seconds. Default
# 2592000 (30 days).
# AXON_OAUTH__REFRESH_TOKEN_TTL_SECS=2592000

# Google sign-in (GenericOidcProvider).
# AXON_OAUTH__PROVIDERS__GOOGLE__ENABLED=false
# AXON_OAUTH__PROVIDERS__GOOGLE__ISSUER=https://accounts.google.com
# AXON_OAUTH__PROVIDERS__GOOGLE__CLIENT_ID=your-client-id.apps.googleusercontent.com
# AXON_OAUTH__PROVIDERS__GOOGLE__CLIENT_SECRET=change-me

# Microsoft (Azure AD) sign-in (GenericOidcProvider).
# AXON_OAUTH__PROVIDERS__MICROSOFT__ENABLED=false
# AXON_OAUTH__PROVIDERS__MICROSOFT__ISSUER=https://login.microsoftonline.com/common/v2.0
# AXON_OAUTH__PROVIDERS__MICROSOFT__CLIENT_ID=00000000-0000-0000-0000-000000000000
# AXON_OAUTH__PROVIDERS__MICROSOFT__CLIENT_SECRET=change-me

# Sign in with Apple. NOT YET IMPLEMENTED — refuses to boot with enabled=true
# until M14c ships AppleProvider.
# AXON_OAUTH__PROVIDERS__APPLE__ENABLED=false
# AXON_OAUTH__PROVIDERS__APPLE__CLIENT_ID=
# native_audiences is a list; set it in axon.toml rather than via env.
# AXON_OAUTH__PROVIDERS__APPLE__TEAM_ID=
# AXON_OAUTH__PROVIDERS__APPLE__KEY_ID=
# AXON_OAUTH__PROVIDERS__APPLE__PRIVATE_KEY=
# AXON_OAUTH__PROVIDERS__APPLE__REDIRECT_URI=
