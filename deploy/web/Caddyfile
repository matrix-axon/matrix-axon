# Front-door Caddy config for the full-stack deployment (ADR 0052).
#
# One origin for the whole stack: serve the built web SPA (/srv) and reverse-
# proxy the API to axon-server on the compose bridge. Same-origin means the
# browser needs no CORS, and the web client's default base URL ("/") works
# unchanged. axon-server itself is NOT published to the host — this is the only
# HTTP entry point, used by the browser AND by non-browser clients (the TUI).
#
# Plain HTTP on :8080 — fine on a trusted LAN. For remote/public access put a
# TLS terminator in front (the `tailscale` or `caddy` compose profiles, which
# proxy to this service), and set AXON_PUBLISH_ADDR=127.0.0.1 in .env so only
# the proxy is reachable from outside the host.

:8080 {
	# Compress SPA assets and proxied JSON (issue #86). Default MIME matcher
	# covers JS/CSS/HTML/JSON and skips image/video; WebSocket upgrades are
	# not encoded. Clients that do not send Accept-Encoding (the TUI's
	# reqwest) get the identity body.
	encode zstd gzip

	# The API surface goes to axon. /healthz lives OUTSIDE /v1, so it needs its
	# own route — otherwise it would fall through to the SPA and return
	# index.html instead of the {"status":"ok"} liveness JSON. reverse_proxy
	# forwards the Authorization header and upgrades /v1/ws transparently, so
	# both browser (Sec-WebSocket-Protocol token) and TUI (bearer header) auth
	# survive the hop; Caddy imposes no request-body cap, so media uploads pass.
	handle /v1/* {
		reverse_proxy axon-server:8080
	}
	handle /healthz {
		reverse_proxy axon-server:8080
	}
	# First-credential web bootstrap (ADR 0052): axon serves the setup page at
	# /bootstrap/<code>. Proxying it here keeps it same-origin with the SPA, so
	# its success page can drop the freshly minted token into the SPA's
	# localStorage and redirect — zero-paste first sign-in.
	handle /bootstrap/* {
		reverse_proxy axon-server:8080
	}

	# Content-hashed bundle assets (ADR 0087). Deliberately NOT under the SPA
	# fallback below: a miss here is a chunk that a redeploy deleted, and it has
	# to 404. Falling through to try_files answers it with index.html and a 200,
	# the browser tries to parse HTML as a module or a stylesheet, and a client
	# still running the previous build hangs with no useful error — the exact
	# failure ADR 0087 exists to fix. `file_server` alone 404s a missing file.
	#
	# The filename carries a content hash, so a given URL's bytes never change
	# and a new build means new URLs: cacheable forever, and the one place in
	# this config where that is true.
	#
	# The header is conditional on the file existing, because `immutable` on the
	# 404 would be a year-long instruction to keep not-finding it: a browser (or
	# an intermediary) that asked one moment too early during a rollout would
	# cache the miss and never retry. A miss is explicitly uncacheable instead.
	handle /assets/* {
		root * /srv
		@exists file {path}
		header @exists Cache-Control "public, max-age=31536000, immutable"
		@missing not file {path}
		header @missing Cache-Control "no-store"
		file_server
	}

	# Everything else is the SPA. try_files rewrites unknown paths to
	# index.html so client-side routes (deep links, /oauth/callback) resolve.
	#
	# These paths are all mutable under a fixed name — index.html, version.json,
	# the manifest, icons — so they must be revalidated rather than served from
	# cache, or a client can boot an old index.html naming assets that are gone.
	# `no-cache` still allows a conditional request, and Caddy answers with a 304
	# off the ETag it already sends, so the cost is headers, not bytes.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
