# Generated by packaging/homebrew/render-formula.sh from axon-server.rb.tmpl.
# CI writes this file to matrix-axon/homebrew-tap on a version tag.
# Edit the template in matrix-axon/matrix-axon, not the generated tap copy.
class AxonServer < Formula
  desc "Self-hosted Matrix state layer between homeservers and clients"
  homepage "https://github.com/matrix-axon/matrix-axon"
  license "Apache-2.0"
  version "@@VERSION@@"

  # Checksums are of the GitHub Release zips from cross-build.yml, not a
  # source build. Asset names are part of that workflow's contract.
  on_macos do
    on_arm do
      url "https://github.com/matrix-axon/matrix-axon/releases/download/@@TAG@@/axon-server-macos-silicon.zip"
      sha256 "@@SHA_MACOS_SILICON@@"
    end
    on_intel do
      url "https://github.com/matrix-axon/matrix-axon/releases/download/@@TAG@@/axon-server-macos-intel.zip"
      sha256 "@@SHA_MACOS_INTEL@@"
    end
  end

  # Linux arm64 has no release zip. Debian/RPM packages cover that hardware.
  # The url stays unconditional on Linux: with no url at all, Homebrew stops
  # at "requires at least a URL" before depends_on arch: can explain.
  on_linux do
    depends_on arch: :x86_64

    url "https://github.com/matrix-axon/matrix-axon/releases/download/@@TAG@@/axon-server-linux.zip"
    sha256 "@@SHA_LINUX_X86_64@@"
  end

  # postgresql@16 is recommended in the caveats. It is intentionally not
  # declared here: Homebrew removed :recommended, and requiring it would
  # force a local cluster on operators who already have a remote database.
  # Tailscale stays in the caveats. Declaring the tailscale formula would
  # conflict with the tailscale-app cask most Macs already have.

  # Tags, not releases/latest: a beta-*/alpha-* GitHub Release is not marked
  # prerelease, so "latest" can be a beta. The regex admits vX.Y.Z only.
  livecheck do
    url "https://github.com/matrix-axon/matrix-axon.git"
    regex(/^v(\d+(?:\.\d+)+)$/i)
  end

  def install
    bin.install "axon-server"
    doc.install "LICENSE.md"
    doc.install "THIRDPARTY"
    # Reverse-proxy site files for the web client (ADR 0116). A glob, because
    # release zips older than that change have none and must still install.
    (doc/"examples").install Dir["axon-server.caddy", "axon-server.*.conf"]
  end

  # Create the service working directory only. Do not write config, generate
  # a store_key, or create the database here — `axon-server init` owns that,
  # and it has to run after Postgres is actually accepting connections.
  def post_install
    (var/"axon-server").mkpath
    (var/"log").mkpath
  end

  # User agent. Do not set AXON_CONFIG or any AXON_* variable: those outrank
  # the config file, so the service would stop agreeing with `axon-server init`.
  service do
    run [opt_bin/"axon-server"]
    keep_alive true
    working_dir var/"axon-server"
    log_path var/"log/axon-server.log"
    error_log_path var/"log/axon-server-error.log"
  end

  def caveats
    text = <<~EOS
      Run `axon-server init` (below) before starting the service. Until
      init has run, the service exits on start, and keep_alive restarts it
      in a loop that fills axon-server-error.log.

      axon-server is a user service. After init, start it as your user:
        brew services start axon-server
      A sudo start reads root's home, so it misses the config init just wrote.

      `axon-server init` writes the platform config. Nothing under the
      Homebrew prefix is the config, the sync store, the search index, or
      the media cache.
        macOS: ~/Library/Application Support/axon-server/config.toml
        Linux: ~/.config/axon-server/config.toml

      PostgreSQL 16 is recommended for a local database. Install it
      yourself when you want one; a remote database can skip it.

      A stock Homebrew PostgreSQL has no role axon, no database axon, and
      no pgcrypto extension, and postgresql@16 is keg-only so createuser
      and psql are not on PATH. init's default URL
      postgres://axon:axon@127.0.0.1:5432/axon
      fails until you create them. initdb's default pg_hba trusts every
      local OS user, so that password is not a boundary between accounts
      on this machine; it is what the URL sends if you later switch
      pg_hba to scram.

      brew install postgresql@16
      brew services start postgresql@16
      PG="$(brew --prefix postgresql@16)/bin"
      "$PG/pg_isready"
      "$PG/psql" -d postgres -v ON_ERROR_STOP=1 <<'SQL'
      DO $$
      BEGIN
        IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'axon') THEN
          CREATE ROLE axon LOGIN PASSWORD 'axon';
        END IF;
      END
      $$;
      SQL
      "$PG/psql" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'axon'" | grep -qx 1 || "$PG/createdb" -E UTF8 -T template0 --owner=axon axon
      "$PG/psql" -d axon -v ON_ERROR_STOP=1 -c "CREATE EXTENSION IF NOT EXISTS pgcrypto;"
      axon-server init --non-interactive --print-token --database-url 'postgres://axon:axon@127.0.0.1:5432/axon'
      brew services start axon-server

      If init stops because a config already exists, leave it. --force
      regenerates store_key and orphans data encrypted with the old key.
      Mint a token later with `axon-server token issue --label laptop`
      when you did not pass --print-token, or when the database was not
      up on the first init.

      Remote database: create the role, the database, and pgcrypto
      yourself, then:
        axon-server init --non-interactive --print-token --database-url 'postgres://USER:PASSWORD@HOST:5432/axon'
        brew services start axon-server
    EOS
    # The site files arrive with the web client (ADR 0116). A release zip from
    # before it has neither, and must not be told about a web client it lacks.
    if (doc/"examples").exist?
      text += <<~EOS

        The server carries the web client and serves it once it is running:
          http://127.0.0.1:8080/
        Only this machine can reach it. Paste the token init printed into
        its sign-in screen. Always open it as 127.0.0.1, not localhost: a
        browser treats those as two sites and keeps a separate sign-in for
        each. Every other browser or device needs its own token:
          axon-server token issue --label phone

        To turn the web client off and serve the API alone, add to the
        config file named above, then restart the service:
          [server]
          web_client = false
          brew services restart axon-server

        To reach it from other devices, put TLS in front, after you have
        signed in once. Tailscale is the least work. Keep axon-server on
        127.0.0.1:8080 (the default), then:
          tailscale serve --bg http://127.0.0.1:8080
        Use the Tailscale menu-bar app if you already have it. On a headless
        Mac mini, `brew install tailscale` is the formula; the cask
        (tailscale-app) conflicts with that formula. This exposes the API
        and the web client on one address.

        For Caddy, nginx, or Apache there is a site file for each, with the
        commands that enable it at the top, in:
          $(brew --prefix)/share/doc/axon-server/examples
        Their comments give Linux package paths; under Homebrew those
        servers keep their config in $(brew --prefix)/etc. Installing
        axon-server does not change any of them.
      EOS
    end
    if OS.linux?
      text += <<~EOS

        This Linux binary is the GitHub Release zip built on ubuntu-latest.
        Its glibc is newer than the Debian and RPM packages, which are
        built on Ubuntu 22.04. A missing GLIBC symbol means use the .deb
        or .rpm instead.
      EOS
    end
    text
  end

  test do
    # Shape only, not #{version}: the binary reports the workspace version
    # in Cargo.toml, which is not bumped to match release tags yet (v0.0.16
    # shipped a binary that prints 0.1.0). Tighten this once the release
    # tag and the Cargo version are guaranteed to agree.
    assert_match(/\Aaxon-server \d+\.\d+\.\d+ /, shell_output("#{bin}/axon-server --version"))
  end
end
