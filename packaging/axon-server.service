[Unit]
Description=Axon personal Matrix state layer
Documentation=man:axon-server(1) https://github.com/matrix-axon/matrix-axon
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=axon
Group=axon
ExecStart=/usr/bin/axon-server --config /etc/axon-server/config.toml
Restart=on-failure
RestartSec=5

ConfigurationDirectory=axon-server
ConfigurationDirectoryMode=0750
StateDirectory=axon-server
CacheDirectory=axon-server
# Pin paths so User=axon (home /nonexistent) does not fall back to CWD-relative
# axon-data/ or a missing XDG tree. Matches ADR 0050's axon-server project dir.
Environment=AXON_SYNC__DATA_DIR=/var/lib/axon-server/sync
Environment=AXON_SEARCH__INDEX_PATH=/var/lib/axon-server/search
Environment=AXON_MEDIA__CACHE_DIR=/var/cache/axon-server/media
Environment=AXON_MEDIA__UPLOADS_DIR=/var/lib/axon-server/uploads
# systemd has no TTY, so arm the one-time first-credential web bootstrap the
# same way the Docker entrypoint does. Still loopback-only unless the operator
# sets server.bootstrap_web_allow_remote.
Environment=AXON_SERVER__BOOTSTRAP_WEB_AUTO=true
# sqlx always opens $HOME/.pgpass. ProtectHome=yes hides /home, so a passwd
# home of /home/axon yields PermissionDenied. StateDirectory is visible.
Environment=HOME=/var/lib/axon-server

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
